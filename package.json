  "keywords": [
    "bunker",
    "bot",
    "plugin",
    "sdk",
    "voice",
    "chat"
  ],
  "homepage": "https://bunker.community/app/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunker-community/plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/bunker-community/plugin-sdk/issues"
  },
  "license": "MIT",
  "author": "Bunker",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "API_DOC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
